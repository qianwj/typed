# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Go workspace files: each developer keeps their own local module
# selection. CI / release builds rely on the per-module go.mod files
# alone, so go.work and go.work.sum are intentionally not committed.
go.work
go.work.sum

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# IDE / editor scratch
.idea/
*.swp
*.swo

# macOS filesystem noise
.DS_Store

# Local AI-agent scratch directory. The directory is created
# by codex-style agents to hold session state and prompts;
# nothing in it belongs in the repository.
.codex/
